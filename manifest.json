{
  "manifest_version": 3,
  "name": "FanficBlock",
  "version": "0.1.1",
  "version_name": "beta-0.1.1",
  "description": "Tira as fanfics corporativas do seu feed do LinkedIn e deixa só o que importa: vaga.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "FanficBlock",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["defaults.js", "extract.js", "classify.js", "stats.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
